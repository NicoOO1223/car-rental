{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "test": "vitest run",
    "check:launch": "node scripts/check-launch.mjs",
    "demo:up": "powershell -NoProfile -File scripts/demo-stack.ps1 up",
    "demo:reseed": "powershell -NoProfile -File scripts/demo-stack.ps1 reseed",
    "demo:down": "powershell -NoProfile -File scripts/demo-stack.ps1 down",
    "screens": "powershell -NoProfile -File scripts/demo-stack.ps1 reseed && node scripts/make-demo-assets.mjs && node scripts/capture-screens.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "use-intl": "^4.14.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
