# Copy this file to .env and fill in real values for local development.

# SQLAlchemy connection string. Local dev (docker-compose postgres service):
DATABASE_URL=postgresql+psycopg://car_rental:car_rental_dev@localhost:5432/car_rental

# Stripe TEST-mode secret key (Dashboard > Developers > API keys, "Secret
# key", test mode). Must match the publishable key in frontend/.env.local.
# Without it, everything except the Stripe-backed handover flow still works.
STRIPE_SECRET_KEY=sk_test_...

# Comma-separated list of allowed frontend origins for CORS. Defaults to
# http://localhost:3000 if unset, so this is only needed when deploying.
CORS_ORIGINS=http://localhost:3000

# Verbose SQL logging. Defaults to false; set true for local debugging.
SQL_ECHO=false

# Signs staff login JWTs — required, no default. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Sentry DSN (Project Settings > Client Keys). Optional — leave unset to
# disable error tracking entirely, e.g. for local development.
SENTRY_DSN=

# "production" disables the /docs, /redoc and /openapi.json endpoints and adds
# HSTS. Leave unset for local development. The Docker image sets it itself.
ENVIRONMENT=development

# Optional. Only set on a deployed stack: a separate login with schema (DDL)
# rights, used just for running migrations, so DATABASE_URL can point at a
# role that can only read and write rows. See create_app_role.py.
MIGRATION_DATABASE_URL=
